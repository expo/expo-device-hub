{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {},
    "clean": {
      "cache": false
    }
  },
  "remoteCache": {
    "preflight": true,
    "apiUrl": "https://turbo.exp.host",
    "teamId": "team_expo-device-hub",
    "teamSlug": "expo-device-hub"
  }
}
