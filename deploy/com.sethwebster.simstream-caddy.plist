<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Caddy terminating HTTPS for simstream.sethwebster.com (see Caddyfile). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sethwebster.simstream-caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>/Users/sethwebster/simstream-live/deploy/Caddyfile</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/sethwebster/Library/Logs/simstream-caddy.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sethwebster/Library/Logs/simstream-caddy.log</string>
</dict>
</plist>
