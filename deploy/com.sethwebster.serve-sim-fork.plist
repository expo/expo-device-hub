<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The serve-sim fork with the simstream video engine, behind Caddy at simstream.sethwebster.com.
     --require-token: serve-sim's tools can act on the host (install apps, read simulator data, stop
     the server), so the page and every API/socket need the access token; SERVE_SIM_TOKEN pins it
     (~/.config/simstream/serve-sim-token) so the shared link survives restarts. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sethwebster.serve-sim-fork</string>
	<key>WorkingDirectory</key>
	<string>/Users/sethwebster/simfork</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>U=B3AFC702-8CB5-45BF-A221-99740EC51B4B; xcrun simctl boot $U 2>/dev/null; xcrun simctl bootstatus $U -b >/dev/null; T=$(cat /Users/sethwebster/.config/simstream/serve-sim-token); SERVE_SIM_TOKEN=$T exec /Users/sethwebster/.asdf/installs/nodejs/24.14.0/bin/node dist/serve-sim.js --transport http --codec simstream --require-token --share-url "https://simstream.sethwebster.com/?token=$T" -p 3200 $U</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/sethwebster/Library/Logs/serve-sim-fork.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sethwebster/Library/Logs/serve-sim-fork.log</string>
</dict>
</plist>
