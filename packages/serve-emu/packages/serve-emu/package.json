{
  "name": "serve-emu",
  "version": "0.0.5",
  "description": "The `npx serve` of Android devices — stream a booted emulator or attached device over WebSocket/WebCodecs or WebRTC H.264.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/middleware.js",
  "module": "./dist/middleware.js",
  "types": "./dist/middleware.d.ts",
  "exports": {
    ".": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./stream-socket": {
      "types": "./dist/stream-socket.d.ts",
      "import": "./dist/stream-socket.js"
    },
    "./stream-settings": {
      "types": "./dist/stream-settings.d.ts",
      "import": "./dist/stream-settings.js"
    }
  },
  "sideEffects": false,
  "author": "jiunshinn",
  "homepage": "https://github.com/expo/serve-emu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/serve-emu.git",
    "directory": "packages/serve-emu"
  },
  "bugs": {
    "url": "https://github.com/expo/serve-emu/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "adb",
    "scrcpy",
    "screen-mirror",
    "remote-control",
    "h264",
    "webcodecs",
    "webrtc",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "bin": {
    "serve-emu": "src/cli.ts"
  },
  "scripts": {
    "setup": "bun run scripts/fetch-scrcpy.ts && bun run build:ui",
    "dev": "bun --watch run src/cli.ts",
    "dev:ui": "vite",
    "start": "bun run src/cli.ts",
    "build:ui": "vite build",
    "build:lib": "swc src -d dist --strip-leading-paths --ignore '**/*.test.ts' && tsc -p tsconfig.build.json && node scripts/fix-dist-imports.mjs",
    "build": "bun run clean && bun run build:ui && bun run build:lib",
    "clean": "rm -rf dist",
    "docs:sync": "bun run scripts/sync-readme.ts --write",
    "docs:check": "bun run scripts/sync-readme.ts --check",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/check-coverage.ts",
    "test:package": "bun run scripts/package-smoke.ts",
    "check:unused": "knip",
    "check": "bun run docs:check && bun run coverage && bun run typecheck && bun run typecheck:ui && bun run typecheck:tests && bun run build && bun run test:package",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p src/ui --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "prepublishOnly": "bun run check"
  },
  "files": [
    "src",
    "scripts",
    "vendor",
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "node-datachannel": "^0.32.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "trustedDependencies": [
    "node-datachannel"
  ],
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knip": "6.26.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
