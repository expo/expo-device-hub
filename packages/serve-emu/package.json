{
  "name": "serve-emu-monorepo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter serve-emu dev",
    "build": "bun run --filter serve-emu build",
    "test": "bun run --filter serve-emu test",
    "docs:sync": "bun run --filter serve-emu docs:sync",
    "docs:check": "bun run --filter serve-emu docs:check",
    "check": "bun run --filter serve-emu check",
    "release": "bun run --filter serve-emu release"
  },
  "trustedDependencies": [
    "node-datachannel"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
