FROM oven/bun:1.3.14 AS bun
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

# Compiler/build tools only; the image does not contain the emulator or driver.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential clang libc++-dev libc++abi-dev \
    libegl-dev libgl-dev pkg-config git curl tar xz-utils unzip \
    python3 python3-venv python3-pip meson ninja-build valac nodejs npm \
    autoconf automake autopoint libtool gettext flex bison gperf \
    nasm yasm texinfo help2man patch libssl-dev libffi-dev libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
ENV HOME=/tmp/capture-home
WORKDIR /work
CMD ["bash"]
