{
  "name": "@expo/hub-client",
  "version": "1.0.0",
  "description": "Device-client React hooks and types for mirroring live iOS simulators and Android emulators in the browser through Expo Device Hub.",
  "keywords": [
    "expo",
    "devtools",
    "simulator",
    "emulator",
    "ios",
    "android",
    "react"
  ],
  "homepage": "https://github.com/expo/expo-device-hub/tree/main/packages/@expo/hub-client",
  "bugs": {
    "url": "https://github.com/expo/expo-device-hub/issues"
  },
  "license": "MIT",
  "author": "Expo",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo-device-hub.git",
    "directory": "packages/@expo/hub-client"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --out-file-extension mjs --delete-dir-on-start --ignore \"**/__tests__/**\" && tsc -p tsconfig.build.json",
    "dev": "swc src -d dist --strip-leading-paths --out-file-extension mjs --ignore \"**/__tests__/**\" -w",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/bun": "latest",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
