{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        ".codex/skills/*/scripts/*.mjs"
      ]
    },
    "packages/serve-sim": {
      "ignoreDependencies": [
        "preact",
        "node-swift"
      ],
      "ignoreBinaries": [
        "Sources/ServeSimCapabilityLoader/tests/run.sh"
      ],
      "entry": [
        "src/index.ts",
        "src/client/client.tsx",
        "src/client/global.css",
        "scripts/build-trails.ts",
        "src/**/__tests__/**/*.test.{ts,tsx}",
        "src/__tests__/fixtures/*.child.ts",
        "scripts/tart/__tests__/*.test.ts"
      ]
    }
  }
}
