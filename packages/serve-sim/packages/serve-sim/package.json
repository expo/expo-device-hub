      "types": "./src/state.ts"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run dev.ts",
    "lint": "cd ../.. && oxlint",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "test:capability-loader": "Sources/ServeSimCapabilityLoader/tests/run.sh",
    "tart": "bun scripts/tart/cli.ts",
