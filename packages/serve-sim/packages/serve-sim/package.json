    "src/ax-shared.ts",
    "src/ax.ts",
    "src/camera-helper.ts",
    "src/connect-to-fetch.ts",
    "src/middleware.ts",
    "src/native.ts",
    "src/state.ts",
    "src/stream-settings.ts",
