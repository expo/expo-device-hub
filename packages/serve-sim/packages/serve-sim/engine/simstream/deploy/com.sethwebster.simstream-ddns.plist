<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs cloudflare-ddns.sh every 5 minutes. Install: copy to ~/Library/LaunchAgents and
     `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sethwebster.simstream-ddns.plist`. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sethwebster.simstream-ddns</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/sethwebster/simstream-live/deploy/cloudflare-ddns.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/sethwebster/Library/Logs/simstream-ddns.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sethwebster/Library/Logs/simstream-ddns.log</string>
</dict>
</plist>
