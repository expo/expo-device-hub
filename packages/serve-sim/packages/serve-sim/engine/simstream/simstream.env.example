# Machine-specific values for the bench/deploy scripts and the handoff notes (continue.md).
# Copy to simstream.env (gitignored) next to this file and fill in; scripts source it if present.
SIMSTREAM_TAILNET=            # Tailscale MagicDNS suffix, e.g. tailXXXXXX.ts.net
SIMSTREAM_HOME_IP=            # home connection's public IPv4 (DDNS keeps Cloudflare in sync)
SIMSTREAM_MINI_LAN_IP=        # Mac Mini's reserved LAN address (router forwards to it)
SIMSTREAM_MINI_MAC=           # Mac Mini's wired MAC (DHCP reservation)
SIMSTREAM_MINI_TS_IP=         # Mac Mini's Tailscale IPv4 (the fork binds here for remote recordings)
SIMSTREAM_ROUTER_ADMIN=       # router admin site (Verizon Fios)
