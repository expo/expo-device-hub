#!/usr/bin/env bash
# Test shim, put first on PATH by scripts/test/unit.sh.
# Refuses `simctl` and `devicectl` so the isolated run can never list,
# screenshot, or drive a booted simulator or a paired phone, even one another
# session uses. Every other xcrun use goes to the real binary.
if [ "${1:-}" = "simctl" ] || [ "${1:-}" = "devicectl" ]; then
  echo "serve-sim test shim: xcrun $1 is blocked during the isolated run" >&2
  exit 1
fi
exec /usr/bin/xcrun "$@"
