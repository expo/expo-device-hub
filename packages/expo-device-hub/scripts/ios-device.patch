@@ -1,0 +2,17 @@
+
+/// CoreDevice pads encoded video at the right/bottom, even after SPS cropping.
+pub fn content_size(width: u32, height: u32, native: Option<(f64, f64)>) -> (u32, u32) {
+    let Some((a, b)) = native.filter(|(a, b)| a.is_finite() && b.is_finite() && *a > 0.0 && *b > 0.0 && *a <= 16384.0 && *b <= 16384.0) else { return (width, height); };
+    let (w, h) = if width > height { (a.max(b), a.min(b)) } else { (a.min(b), a.max(b)) };
+    let scale = (f64::from(width) / w).min(f64::from(height) / h).min(1.0);
+    ((w * scale).round() as u32, (h * scale).round() as u32)
+}
+
+#[test]
+fn removes_encoder_padding_without_cropping_the_display() {
+    assert_eq!(content_size(1216, 2656, Some((1206.0, 2622.0))), (1206, 2622));
+    assert_eq!(content_size(2656, 1216, Some((1206.0, 2622.0))), (2622, 1206));
+    assert_eq!(content_size(2736, 2064, Some((2752.0, 2064.0))), (2736, 2052));
+    assert_eq!(content_size(1216, 2656, None), (1216, 2656));
+    assert_eq!(content_size(1216, 2656, Some((f64::NAN, 0.0))), (1216, 2656));
+}
