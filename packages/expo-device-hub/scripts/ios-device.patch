+pub fn display_size(info: &plist::Value) -> Option<(f64, f64)> {
+    let displays = info.as_dictionary()?.get("displays")?.as_array()?;
+    let display = displays.iter().filter_map(plist::Value::as_dictionary)
+        .find(|display| display.get("primary").and_then(plist::Value::as_boolean) == Some(true))?;
+    let size = display.get("nativeSize")?.as_array()?;
+    Some((size.first()?.as_real()?, size.get(1)?.as_real()?))
+}
