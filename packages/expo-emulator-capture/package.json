{
  "name": "expo-emulator-capture",
  "version": "0.0.0",
  "description": "GPU-accelerated Android Emulator capture for macOS on Apple silicon",
  "keywords": [
    "android",
    "apple-silicon",
    "emulator",
    "expo",
    "h264",
    "iosurface",
    "macos",
    "streaming",
    "video-capture",
    "videotoolbox"
  ],
  "homepage": "https://github.com/expo/expo-device-hub/tree/main/packages/expo-emulator-capture",
  "bugs": {
    "url": "https://github.com/expo/expo-device-hub/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Expo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/expo-device-hub.git",
    "directory": "packages/expo-emulator-capture"
  },
  "bin": {
    "expo-emulator-capture": "src/cli.mjs"
  },
  "files": [
    "src",
    "dist/darwin-arm64/libexpo_emulator_capture.dylib",
    "README.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.mjs",
    "./paths": "./src/paths.mjs"
  },
  "scripts": {
    "build": "bun run setup:build && bun run build:native",
    "setup:build": "bun scripts/setup-build.mjs",
    "build:native": "bun scripts/build.mjs",
    "capture": "node src/cli.mjs",
    "test": "bun run test:native && bun test tests",
    "test:native": "bun scripts/test-native.mjs",
    "prepublishOnly": "node scripts/check-dist.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
